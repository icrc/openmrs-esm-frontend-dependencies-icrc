{
  "name": "@icrc/esm-frontend-dependencies",
  "version": "1.1.0",
  "description": "Packages which bundles all the dependencies for ICRC OpenMRS",
  "main": "index.js",
  "scripts": {
    "build": "packmap -p packmap-package.json -o openmrs/frontend --override-map ./overriding-import-map.json && cp -r ./statics/* ./openmrs/frontend/",
    "build-dev": "packmap -p packmap-package.json -o openmrs/frontend --override-map ./overriding-import-map-local.json && cp -r ./statics/* ./openmrs/frontend/",
    "deploy-docker": "npm run build-dev && sh ./scripts/deploy-to-docker.sh",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "browserslist": [
    "extends browserslist-config-openmrs"
  ],
  "keywords": [
    "openmrs",
    "microfrontends"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icrc/openmrs-esm-frontend-dependencies-icrc.git"
  },
  "homepage": "https://github.com/icrc/openmrs-esm-frontend-dependencies-icrc#readme",
  "bugs": {
    "url": "https://github.com/icrc/openmrs-esm-frontend-dependencies-icrc/issues"
  },
  "author": "",
  "license": "BSD-3-Clause",
  "directories": {
    "lib": "openmrs"
  },
  "devDependencies": {
    "@openmrs/esm-api": "3.0.0",
    "@openmrs/esm-devtools": "1.2.0",
    "@openmrs/esm-error-handling": "^1.1.1",
    "@icrc/esm-icrc-overrides-app": "1.0.3",
    "@openmrs/esm-module-config": "^1.3.1",
    "@openmrs/esm-patient-chart-app": "0.1.0",
    "@openmrs/esm-patient-chart-widgets": "1.0.3",
    "@openmrs/esm-refapp-navigation-app": "1.0.1-beta",
    "@openmrs/esm-refapp-styleguide-app": "1.0.1",
    "@openmrs/esm-styleguide": "~1.3.0",
    "@openmrs/esm-user-dashboard-app": "1.0.1",
    "@openmrs/esm-user-dashboard-widgets": "1.0.3-pre.14",
    "@icrc/esm-icrc-user-dashboard-widgets": "4.0.0",
    "import-map-overrides": "1.9.1",
    "packmap": "~1.3.0",
    "react": "~16.13.1",
    "react-dom": "~16.13.1",
    "rxjs": "~6.5.5",
    "single-spa": "~4.4.1",
    "systemjs": "6.1.3",
    "react-grid-gallery": "0.5.5",
    "tiny-invariant": "1.2.0"
  }
}
