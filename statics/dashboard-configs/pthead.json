{
  "title": "PT Head Dashboard",
  "layout": {
    "columns": 2
  },
  "contents": [
    {
      "size": {
        "rows": 1,
        "columns": 1
      },
      "library": {
        "module": "@openmrs/esm-user-dashboard-widgets",
        "name": "Appointment"
      },
      "properties": {
        "title": "Today's Appointments",
        "source": {
          "url": "/ws/rest/v1/appointments",
          "fetchType": "self",
          "fromTimeDelayInMinutes": "60",
          "filters": [
            {
              "field": "status",
              "values": [
                "Scheduled",
                "CheckedIn"
              ]
            }
          ]
        },
        "actions": [
          {
            "name": "Done",
            "when": [
              {
                "field": "status",
                "values": [
                  "Scheduled",
                  "CheckedIn"
                ]
              }
            ]
          }
        ],
        "viewAll": "../../appointments/index.html#/home/manage/appointments/calendar?provider=%provider%",
        "viewAllWindow": "new"
      }
    },
    {
      "size": {
        "rows": 1,
        "columns": 1
      },
      "library": {
        "module": "@openmrs/esm-user-dashboard-widgets",
        "name": "Appointment"
      },
      "properties": {
        "title": "To Do Appointments to be confirmed",
        "source": {
          "url": "/ws/rest/v1/appointments",
          "fetchType": "self",
          "fromTimeDelayInMinutes": "600",
          "showFutureAppointments": true,
          "showDate": true,
          "providerStatusFilterType": "self",
          "filters": [
            {
              "field": "status",
              "values": [
                "Requested",
                "Scheduled"
              ]
            }
          ]
        },
        "actions": [
          {
            "name": "Edit",
            "when": []
          },
          {
            "name": "Accept",
            "when": []
          }
        ],
        "viewAll": "../spa/dashboard/allappointments"
      }
    },
